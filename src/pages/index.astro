---
import Layout from "../layouts/Layout.astro";
import { getTestsGenerados, getTodasLasPreguntas } from "../lib/tests";

const [tests, preguntas] = await Promise.all([
    getTestsGenerados(),
    getTodasLasPreguntas(),
]);
const ids = preguntas.map((p) => p.id);
const apartados = [
    {
        href: `${import.meta.env.BASE_URL}tests`,
        titulo: "Tests numerados",
        descripcion: `${tests.length} tests de 30 preguntas.`,
        icono: "📝",
    },
    {
        href: `${import.meta.env.BASE_URL}fallos`,
        titulo: "Tests que he fallado alguna vez",
        descripcion: "Preguntas que has fallado al menos una vez (nivel medio y difícil).",
        icono: "🔄",
    },
    {
        href: `${import.meta.env.BASE_URL}siempre-fallo`,
        titulo: "Tests que siempre fallo",
        descripcion: "Solo preguntas que sigues fallando (nivel difícil).",
        icono: "❌",
    },
];
---

<Layout titulo="Tests DGT: practica el examen teórico">
    <section class="intro">
        <h1>Practica el teórico de la DGT</h1>
        <p>
            {preguntas.length} preguntas oficiales. Tu progreso se guarda en
            este navegador.
        </p>
    </section>

    <section class="progreso" id="progreso" aria-label="Tu progreso">
        <div class="dato facil">
            <strong data-nivel="facil">–</strong>
            <span>Fáciles</span>
        </div>
        <div class="dato medio">
            <strong data-nivel="medio">–</strong>
            <span>Medias</span>
        </div>
        <div class="dato dificil">
            <strong data-nivel="dificil">–</strong>
            <span>Difíciles</span>
        </div>
        <div class="dato">
            <strong id="pendientes">–</strong>
            <span>Sin hacer</span>
        </div>
        <div class="dato probabilidad" id="probabilidad-container">
            <strong id="probabilidad">–</strong>
            <span>Fallos en examen</span>
        </div>
    </section>
    <script
        is:inline
        type="application/json"
        id="ids-validos"
        set:html={JSON.stringify(ids)}
    />
    <section class="apartados">
        {apartados.map((a) => (
            <a class="tarjeta" href={a.href}>
                <span class="icono" aria-hidden="true">
                    {a.icono}
                </span>
                <h2>{a.titulo}</h2>
                <p>{a.descripcion}</p>
            </a>
        ))}
    </section>
</Layout>

<script>
    import { cargarProgreso, contarFallosTotales } from "../lib/progreso";
    import { resumenProgreso } from "../lib/seleccion";

    const contenedor = document.getElementById("progreso");
    const datos = document.getElementById("ids-validos");

    if (contenedor && datos) {
        const ids: string[] = JSON.parse(datos.textContent ?? "[]");
        const progreso = cargarProgreso();
        const resumen = resumenProgreso(ids, progreso);

        for (const nivel of ["facil", "medio", "dificil"] as const) {
            const el = contenedor.querySelector(`[data-nivel="${nivel}"]`);
            if (el) el.textContent = String(resumen[nivel]);
        }
        const pendientes = document.getElementById("pendientes");
        if (pendientes) pendientes.textContent = String(resumen.sinHacer);

        // Calcular probabilidad de aprobar el examen
        const preguntasHechas = resumen.facil + resumen.medio + resumen.dificil;
        const fallos = contarFallosTotales(progreso);
        const probabilidadElement = document.getElementById("probabilidad");
        const probabilidadContainer = document.getElementById("probabilidad-container");

        if (probabilidadElement && probabilidadContainer) {
            if (preguntasHechas > 0) {
                const fallosEstimados = (fallos / preguntasHechas) * 30;
                probabilidadElement.textContent = fallosEstimados.toFixed(1);

                if (fallosEstimados > 3) {
                    probabilidadContainer.style.color = "#e74c3c";
                    probabilidadElement.textContent += " - ¡Sigue estudiando!";
                } else {
                    probabilidadContainer.style.color = "#27ae60";
                    probabilidadElement.textContent += " - ¡Bien!";
                }
            } else {
                probabilidadElement.textContent = "–";
            }
        }
    }
</script>

<style>
    .intro h1 {
        margin: 0 0 0.25rem;
        font-size: 1.9rem;
    }
    .intro p {
        margin: 0 0 1.5rem;
        color: var(--color-suave);
    }

    .progreso {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
        gap: 0.75rem;
        margin-bottom: 2rem;
    }
    .dato {
        background: var(--color-tarjeta);
        border: 1px solid var(--color-borde);
        border-radius: 12px;
        padding: 0.8rem 1rem;
        border-top: 4px solid var(--color-borde);
    }
    .dato strong {
        display: block;
        font-size: 1.6rem;
    }
    .dato span {
        color: var(--color-suave);
        font-size: 0.85rem;
    }
    .dato.facil {
        border-top-color: var(--color-facil);
    }
    .dato.medio {
        border-top-color: var(--color-medio);
    }
    .dato.dificil {
        border-top-color: var(--color-dificil);
    }
    .dato.probabilidad {
        border-top-color: var(--color-primario);
    }

    .apartados {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
    }
    .tarjeta {
        background: var(--color-tarjeta);
        border: 1px solid var(--color-borde);
        border-radius: 14px;
        padding: 1.4rem;
        text-decoration: none;
        color: inherit;
        transition:
            transform 0.15s,
            box-shadow 0.15s;
    }
    .tarjeta:hover,
    .tarjeta:focus-visible {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgb(0 0 0 / 0.08);
        outline: none;
        border-color: var(--color-primario);
    }
    .icono {
        font-size: 2rem;
    }
    .tarjeta h2 {
        margin: 0.5rem 0 0.25rem;
        font-size: 1.2rem;
    }
    .tarjeta p {
        margin: 0;
        color: var(--color-suave);
    }
</style>
